{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main Hush window — core APIs, daemon proxy, chat file open/save, Drops, and the desktop updater",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-hush-files",
    "allow-hush-url",
    "allow-hush-api",
    "allow-drops",
    "allow-chat-sound",
    "allow-irc",
    "updater:default",
    "process:allow-restart"
  ]
}
