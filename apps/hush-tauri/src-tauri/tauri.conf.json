{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hush",
  "version": "0.6.0",
  "identifier": "com.hush.capsule",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hush",
        "width": 1100,
        "height": 760,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; connect-src 'self' http://127.0.0.1:9876 http://127.0.0.1:9877 http://127.0.0.1:8787; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/hush-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tor/tor": "tor/tor",
      "resources/tor/libevent-2.1.so.7": "tor/libevent-2.1.so.7",
      "resources/tor/LICENSE": "tor/LICENSE"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2ODlDQjdFOTU3MkM2RTQKUldUa3huS1Zmc3VKWmgyOGJaRkVlSFVtMXVNaTI3UW1udzJlVTVTT2tyd2krRWdOMXRkUGtXYjYK",
      "endpoints": [
        "https://hushrelay.space/updates/latest.json"
      ]
    }
  }
}
