{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hush",
  "version": "0.1.0",
  "identifier": "com.hush.capsule",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Hush",
        "width": 920,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:9876; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
