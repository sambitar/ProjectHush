{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hush",
  "version": "0.1.0",
  "identifier": "com.hush.capsule",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hush",
        "width": 1100,
        "height": 760,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; connect-src 'self' http://127.0.0.1:9876 http://127.0.0.1:9877 http://127.0.0.1:8787; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false
  }
}
